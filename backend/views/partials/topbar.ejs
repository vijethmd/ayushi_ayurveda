<nav class="topbar">
  <button class="sidebar-toggle d-lg-none" onclick="toggleSidebar()">
    <i class="bi bi-list"></i>
  </button>
  <h5 class="topbar-title"><%= typeof title !== 'undefined' ? title : 'AYUSHI' %></h5>
  <div class="topbar-actions">
    <a href="/notifications" class="topbar-btn position-relative" title="Notifications">
      <i class="bi bi-bell"></i>
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
      <span class="notif-badge"><%= unreadCount %></span>
      <% } %>
    </a>
    <a href="/profile" class="topbar-btn" title="Profile">
      <i class="bi bi-person-circle"></i>
    </a>
  </div>
</nav>
