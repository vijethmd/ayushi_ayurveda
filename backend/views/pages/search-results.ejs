<%- include('../partials/head', { title: title }) %>
<%
  const facet = facets[type].by[by];
  const money = (n) => n == null ? '' : '₹' + Number(n).toLocaleString('en-IN');
%>
<div class="pub-page pub-page-results">
  <%- include('../partials/public-header', { facets, loggedIn, active: { type, by, q }, navActive:'' }) %>

  <section class="pub-results">
    <div class="pub-wrap">

      <div class="pub-results-head">
        <div>
          <p class="pub-crumb">
            <a href="/">Home</a> <i class="bi bi-chevron-right"></i>
            <%= facets[type].label %> <i class="bi bi-chevron-right"></i> by <%= facet.label %>
          </p>
          <h1>
            <i class="bi <%= facet.icon %>"></i>
            <% if (q) { %>“<%= q %>”<% } else { %>All <%= facets[type].label.toLowerCase() %><% } %>
          </h1>
          <p class="pub-results-count">
            <strong><%= results.length %></strong>
            <%= results.length === 1 ? 'result' : 'results' %>
            <% if (q) { %> matching <%= facet.label.toLowerCase() %> <em><%= q %></em><% } %>
          </p>
        </div>
        <form class="pub-refine" action="/search" method="GET">
          <input type="hidden" name="type" value="<%= type %>"/>
          <input type="hidden" name="by"   value="<%= by %>"/>
          <div class="pub-input-wrap">
            <i class="bi bi-search"></i>
            <input type="text" name="q" class="pub-input" value="<%= q %>"
                   placeholder="<%= facet.placeholder %>" autocomplete="off"/>
            <button type="submit" class="pub-go"><i class="bi bi-arrow-right-short"></i></button>
          </div>
        </form>
      </div>

      <!-- Switch facet without going back to the landing page -->
      <div class="pub-tabs">
        <% Object.entries(facets).forEach(([t, group]) => {
             Object.entries(group.by).forEach(([b, f]) => { %>
        <a class="pub-tab <%= (t===type && b===by) ? 'active' : '' %>"
           href="/search?type=<%= t %>&by=<%= b %>&q=<%= encodeURIComponent(q) %>">
          <i class="bi <%= f.icon %>"></i><%= group.label %> · <%= f.label %>
        </a>
        <% }); }) %>
      </div>

      <% if (!results.length) { %>
        <div class="pub-empty">
          <i class="bi bi-search"></i>
          <h3>Nothing found</h3>
          <p>No <%= facets[type].label.toLowerCase() %> match <%= facet.label.toLowerCase() %> “<%= q %>”.</p>
          <a class="pub-cta pub-cta-gold" href="/search?type=<%= type %>&by=<%= by %>&q=">Show everything</a>
        </div>

      <% } else if (type === 'doctors') { %>
        <div class="pub-grid">
          <% results.forEach(d => { %>
          <article class="pub-card pub-card-doctor">
            <div class="pub-card-top">
              <span class="pub-avatar"><%= d.name.replace(/^Dr\.?\s*/i,'').trim().charAt(0).toUpperCase() %></span>
              <div>
                <h3><%= d.name %></h3>
                <p class="pub-card-qual"><%= d.qualification || 'BAMS' %><% if (d.experience_years) { %> · <%= d.experience_years %> yrs experience<% } %></p>
              </div>
            </div>
            <span class="pub-badge"><i class="bi bi-clipboard2-pulse"></i><%= d.specialization || 'General Medicine' %></span>
            <ul class="pub-meta">
              <% if (d.clinic_name) { %><li><i class="bi bi-hospital"></i><%= d.clinic_name %></li><% } %>
              <% if (d.area || d.city) { %>
              <li><i class="bi bi-geo-alt"></i><%= [d.area, d.city, d.state].filter(Boolean).join(', ') %></li>
              <% } %>
              <% if (d.languages) { %><li><i class="bi bi-translate"></i><%= d.languages %></li><% } %>
            </ul>
            <div class="pub-card-foot">
              <% if (d.consultation_fee) { %>
              <span class="pub-fee"><%= money(d.consultation_fee) %> <em>consultation</em></span>
              <% } %>
              <% if (d.area) { %>
              <a class="pub-link" href="/search?type=doctors&by=area&q=<%= encodeURIComponent(d.area) %>">
                More in <%= d.area %> <i class="bi bi-arrow-right"></i>
              </a>
              <% } %>
            </div>
          </article>
          <% }) %>
        </div>

      <% } else if (by === 'generic') { %>
        <div class="pub-grid">
          <% results.forEach(m => { %>
          <article class="pub-card pub-card-med">
            <h3><%= m.generic_name || m.name %></h3>
            <% if (m.botanical_name) { %><p class="pub-botanical"><%= m.botanical_name %></p><% } %>
            <div class="pub-tag-row">
              <% if (m.category) { %><span class="pub-badge pub-badge-soft"><%= m.category %></span><% } %>
              <% if (m.dosage_form) { %><span class="pub-badge pub-badge-soft"><i class="bi bi-capsule"></i><%= m.dosage_form %></span><% } %>
            </div>
            <% if (m.traditional_use) { %>
            <p class="pub-card-desc"><%= m.traditional_use %></p>
            <% } %>
            <div class="pub-card-foot">
              <span class="pub-fee"><strong><%= m.brand_count %></strong> <em>brand<%= m.brand_count === 1 ? '' : 's' %></em></span>
              <a class="pub-link" href="/search?type=medicines&by=brand&q=<%= encodeURIComponent(m.generic_name || m.name) %>">
                See brands <i class="bi bi-arrow-right"></i>
              </a>
            </div>
            <% if (m.makers) { %><p class="pub-makers"><i class="bi bi-building"></i><%= m.makers %></p><% } %>
          </article>
          <% }) %>
        </div>

      <% } else { %>
        <div class="pub-table-wrap">
          <table class="pub-table">
            <thead>
              <tr>
                <th>Brand</th><th>Manufacturer</th><th>Generic / Formulation</th>
                <th>Form</th><th>Pack</th><th class="text-end">MRP</th>
              </tr>
            </thead>
            <tbody>
              <% results.forEach(b => { %>
              <tr>
                <td><strong><%= b.brand_name %></strong></td>
                <td>
                  <a class="pub-link" href="/search?type=medicines&by=manufacturer&q=<%= encodeURIComponent(b.manufacturer) %>">
                    <%= b.manufacturer %>
                  </a>
                </td>
                <td>
                  <a class="pub-link" href="/search?type=medicines&by=generic&q=<%= encodeURIComponent(b.generic_name || b.drug_name) %>">
                    <%= b.generic_name || b.drug_name %>
                  </a>
                  <% if (b.category) { %><span class="pub-sub-cell"><%= b.category %></span><% } %>
                </td>
                <td><%= b.dosage_form || '—' %></td>
                <td><%= b.pack_size || '—' %></td>
                <td class="text-end"><%= b.mrp ? money(b.mrp) : '—' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

    </div>
  </section>

  <%- include('../partials/public-footer', { references }) %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
