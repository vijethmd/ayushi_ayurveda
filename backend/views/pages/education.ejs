<%- include('../partials/head', { title: title }) %>
<div class="pub-page pub-page-results">
  <%- include('../partials/public-header', { facets, loggedIn, active:{type:'',by:'',q:''}, navActive:'education' }) %>

  <section class="pub-results">
    <div class="pub-wrap">
      <p class="pub-crumb"><a href="/">Home</a> <i class="bi bi-chevron-right"></i> Education</p>
      <h1 class="pub-page-title"><i class="bi bi-mortarboard"></i> AYUSH education in India</h1>
      <p class="pub-page-lede">How one qualifies to practise Ayurveda in India.</p>

      <!-- Regulator -->
      <div class="edu-regulator">
        <div>
          <span class="pub-badge"><i class="bi bi-shield-check"></i>Statutory regulator</span>
          <h2><%= edu.regulator.name %></h2>
          <p><%= edu.regulator.note %></p>
        </div>
        <div class="edu-reg-links">
          <a href="<%= edu.regulator.url %>" target="_blank" rel="noopener noreferrer" class="pub-cta pub-cta-gold">
            NCISM <i class="bi bi-box-arrow-up-right"></i>
          </a>
          <a href="<%= edu.ministry.url %>" target="_blank" rel="noopener noreferrer" class="pub-link">
            <%= edu.ministry.name %> <i class="bi bi-box-arrow-up-right"></i>
          </a>
        </div>
      </div>

      <!-- The five AYUSH streams -->
      <h2 class="edu-h2"><i class="bi bi-diagram-2"></i> The five AYUSH systems</h2>
      <div class="edu-streams">
        <% edu.streams.forEach(([letter, name, degree]) => { %>
        <div class="edu-stream <%= name === 'Ayurveda' ? 'on' : '' %>">
          <span class="edu-letter"><%= letter %></span>
          <strong><%= name %></strong>
          <em><%= degree %></em>
        </div>
        <% }) %>
      </div>

      <!-- Degrees -->
      <h2 class="edu-h2"><i class="bi bi-award"></i> Qualifications in Ayurveda</h2>
      <div class="edu-degrees">
        <% edu.degrees.forEach(d => { %>
        <article class="edu-degree">
          <div class="edu-degree-head">
            <h3><%= d.code %></h3>
            <span class="pub-badge pub-badge-soft"><i class="bi bi-clock"></i><%= d.duration %></span>
          </div>
          <p class="edu-full"><%= d.full %></p>
          <p class="edu-entry"><i class="bi bi-door-open"></i><strong>Entry:</strong> <%= d.entry %></p>
        </article>
        <% }) %>
      </div>

      <!-- Entrance exams -->
      <h2 class="edu-h2"><i class="bi bi-pencil-square"></i> Entrance examinations</h2>
      <div class="edu-exams">
        <% edu.exams.forEach(([name, what, url]) => { %>
        <a class="edu-exam" href="<%= url %>" target="_blank" rel="noopener noreferrer">
          <strong><%= name %> <i class="bi bi-box-arrow-up-right"></i></strong>
          <p><%= what %></p>
        </a>
        <% }) %>
      </div>

      <!-- Institutions -->
      <h2 class="edu-h2"><i class="bi bi-bank"></i> Leading institutions</h2>
      <div class="edu-inst-grid">
        <% edu.institutions.forEach((i, n) => { %>
        <article class="edu-inst">
          <span class="edu-inst-n"><%= String(n + 1).padStart(2, '0') %></span>
          <div>
            <h3><%= i.name %></h3>
            <p class="edu-city"><i class="bi bi-geo-alt"></i><%= i.city %></p>
          </div>
        </article>
        <% }) %>
      </div>

    </div>
  </section>

  <%- include('../partials/public-footer', { references }) %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
