<%- include('../partials/head', { title: drug.name }) %>
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'drug-research' }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { title: drug.name }) %>
    <div class="page-body">
      <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/drug-research" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div class="flex-grow-1">
          <span class="badge bg-light text-primary border mb-1"><%=drug.category%></span>
          <h5 class="mb-0 text-green"><%=drug.name%></h5>
          <small class="text-muted"><%=drug.traditional_use||''%></small>
        </div>
        <button class="btn btn-sm" style="background:linear-gradient(135deg,#c9a84c,#a07a28);color:#fff;" onclick="genDrugAI()">
          <i class="bi bi-robot me-1"></i>AI Research Report
        </button>
      </div>
      <div class="row g-2 mb-3">
        <% [['Prescribed',drug.times_prescribed||0,'#4a7c59'],['Patients',drug.patients_treated||0,'#2980b9'],['Cure Rate',drug.avg_efficacy!=null?(drug.avg_efficacy+'%'):'—','#27ae60'],['Avg Days/Cure',drug.avg_days_to_cure!=null?(drug.avg_days_to_cure+'d'):'—','#c9a84c']].forEach(([l,v,c])=>{ %>
        <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body py-2"><div class="fw-bold" style="font-size: 22px;color:<%=c%>;font-family:'Playfair Display',serif;"><%=v%></div><div class="text-muted" style="font-size: 13px;"><%=l%></div></div></div></div>
        <% }) %>
      </div>
      <div id="aiBox" class="card mb-3 d-none" style="border:2px solid #c9a84c;background:#fdfbf7;">
        <div class="card-body">
          <div id="aiContent" class="ai-report-body"></div>
        </div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col-md-6"><div class="card h-100"><div class="card-header fw-semibold">Monthly Cure Rate</div><div class="card-body" style="height:200px;"><canvas id="trendChart"></canvas></div></div></div>
        <div class="col-md-6"><div class="card h-100"><div class="card-header fw-semibold">Performance by Disease</div>
          <div class="table-responsive" style="max-height:200px;">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>Disease</th><th>Cases</th><th>Cure Rate</th><th>Cured</th></tr></thead>
              <tbody>
                <% (diseaseBreakdown||[]).forEach(d=>{ const col=d.avg_efficacy>=75?'#27ae60':d.avg_efficacy>=50?'#f39c12':'#e74c3c'; %>
                <tr><td><small class="fw-medium"><%=d.disease_name%></small></td><td><small><%=d.prescriptions%></small></td>
                <td><% if(d.avg_efficacy){ %><span style="font-size: 14px;font-weight:600;color:<%=col%>;"><%=d.avg_efficacy%>%</span><% }else{ %>—<% } %></td>
                <td><small style="color:#27ae60;font-weight:600;"><%=d.cured%></small></td></tr>
                <% }) %>
                <% if (!diseaseBreakdown?.length) { %><tr><td colspan="4" class="text-center py-3 text-muted">No data</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div></div>
      </div>
      <div class="card">
        <div class="card-header fw-semibold">Patient Administrations</div>
        <div class="table-responsive" style="max-height:300px;">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Patient</th><th>Disease</th><th>Doctor</th><th>Dosage</th><th>Status</th></tr></thead>
            <tbody>
              <% (administrations||[]).forEach(a=>{ %>
              <tr>
                <td><div style="font-size: 14px;font-weight:500;"><%=a.patient_name%></div><small class="text-muted monospace"><%=a.patient_code%> <%=a.age%>y</small></td>
                <td><small><%=a.disease_name%></small></td>
                <td><small><%=a.doctor_name%></small></td>
                <td><small><%=a.dosage||'—'%> <%=a.frequency||''%></small></td>
                <td><span class="badge <%=a.treatment_status==='Cured'?'bg-success':a.treatment_status==='Ongoing'?'bg-primary':'bg-secondary'%>" style="font-size: 12px;"><%=a.treatment_status%></span></td>
              </tr>
              <% }) %>
              <% if (!administrations?.length) { %><tr><td colspan="5" class="text-center py-3 text-muted">No records</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
const trend=<%- JSON.stringify(outcomesTrend||[]) %>;
if(trend.length) new Chart(document.getElementById('trendChart'),{type:'line',data:{labels:trend.map(t=>t.month),datasets:[{label:'Cure Rate %',data:trend.map(t=>t.avg_efficacy),borderColor:'#4a7c59',backgroundColor:'rgba(74,124,89,0.08)',tension:0.4,fill:true,pointRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{min:0,max:100}}}});
async function genDrugAI(refresh) {
  const box=document.getElementById('aiBox'); const content=document.getElementById('aiContent');
  box.classList.remove('d-none');
  content.innerHTML='<div class="text-center py-3"><span class="spinner-border spinner-border-sm text-warning"></span> '+(refresh?'Regenerating with AI…':'Loading AI research report…')+'</div>';
  try {
    const r=await API.post('/api/drugs/ai/<%=drug.drug_id%>'+(refresh?'?refresh=1':''));
    const md=typeof marked!=='undefined'?marked.parse(r.report.report_text):r.report.report_text;
    let bar='<div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">';
    bar+='<small class="text-muted">'+(r.cached?('<i class="bi bi-clock-history me-1"></i>Saved report'+(r.generated_at?' · '+new Date(r.generated_at).toLocaleString():'')):'<i class="bi bi-stars me-1"></i>Freshly generated')+'</small>';
    bar+='<button class="btn btn-xs btn-outline-secondary" style="font-size: 13px;padding:2px 8px;" onclick="genDrugAI(true)"><i class="bi bi-arrow-clockwise me-1"></i>Regenerate</button></div>';
    content.innerHTML=bar+md; content.classList.add('ai-report-body');
  }
  catch(e){ content.innerHTML='<div class="text-danger">'+e.message+'</div>'; }
}
</script>
<%- include('../partials/scripts') %>