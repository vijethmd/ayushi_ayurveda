<%- include('../partials/head', { title: 'Join Requests' }) %>
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'doctor-requests' }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { title: 'Doctor Join Requests' }) %>
    <div class="page-body">

      <% if (success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
      <% } %>
      <% if (error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
      <% } %>

      <% if (!emailConfigured) { %>
      <div class="alert alert-warning" role="alert">
        <i class="bi bi-envelope-exclamation me-1"></i>
        <strong>Email not configured.</strong> Approving a doctor emails them their password, so set
        <code>EMAIL_USER</code> and <code>EMAIL_PASS</code> (a Gmail App Password) in your <code>.env</code> file first.
        Approval is disabled until then.
      </div>
      <% } %>

      <% const pending = requests.filter(r => r.status === 'pending');
         const reviewed = requests.filter(r => r.status !== 'pending'); %>

      <!-- Pending requests -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 text-green">Pending Requests <span class="badge bg-danger rounded-pill"><%= pending.length %></span></h5>
      </div>

      <% if (pending.length === 0) { %>
      <div class="card mb-4"><div class="card-body text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size:32px;"></i>
        <p class="mb-0 mt-2">No pending join requests.</p>
      </div></div>
      <% } else { %>
      <div class="row g-3 mb-4">
        <% pending.forEach(r => { %>
        <div class="col-md-6 col-xl-4">
          <div class="card h-100">
            <div class="card-body">
              <div class="d-flex gap-3 mb-3">
                <div class="pat-avatar" style="width:48px;height:48px;font-size:18px;font-weight:700;background:#e8f5e9;color:#4a7c59;"><%= r.name.charAt(0).toUpperCase() %></div>
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-semibold text-truncate"><%= r.name %></div>
                  <small class="text-muted text-truncate d-block"><i class="bi bi-envelope me-1"></i><%= r.email %></small>
                  <% if (r.phone) { %><small class="text-muted"><i class="bi bi-phone me-1"></i><%= r.phone %></small><% } %>
                </div>
              </div>
              <% if (r.specialization) { %>
              <div class="mb-2"><span class="badge bg-light text-primary border" style="font-size:11px;"><%= r.specialization %></span></div>
              <% } %>
              <p class="small text-muted mb-2" style="white-space:pre-wrap;"><%= r.description %></p>
              <div class="text-muted" style="font-size:11px;"><i class="bi bi-clock me-1"></i>Requested <%= new Date(r.created_at).toLocaleString() %></div>

              <div class="d-flex gap-2 mt-3">
                <form method="POST" action="/doctor-requests/<%= r.request_id %>/approve" class="flex-grow-1 approve-form"
                      data-name="<%= r.name %>" data-email="<%= r.email %>">
                  <button type="submit" class="btn btn-sm btn-primary w-100" <%= emailConfigured ? '' : 'disabled' %>>
                    <i class="bi bi-check-circle me-1"></i>Approve & Email
                  </button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-danger reject-btn"
                        data-id="<%= r.request_id %>" data-name="<%= r.name %>">
                  <i class="bi bi-x-circle"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>

      <!-- Reviewed history -->
      <% if (reviewed.length > 0) { %>
      <h5 class="mb-3 text-green">Reviewed</h5>
      <div class="card">
        <div class="card-body p-0">
          <table class="table table-hover mb-0 align-middle">
            <thead>
              <tr><th>Name</th><th>Email</th><th>Specialization</th><th>Status</th><th>Reviewed By</th><th>When</th></tr>
            </thead>
            <tbody>
            <% reviewed.forEach(r => { %>
              <tr>
                <td><%= r.name %></td>
                <td class="text-muted"><%= r.email %></td>
                <td><%= r.specialization || '—' %></td>
                <td>
                  <% if (r.status === 'approved') { %>
                  <span class="badge bg-success">Approved</span>
                  <% } else { %>
                  <span class="badge bg-secondary">Rejected</span>
                  <% } %>
                </td>
                <td class="text-muted"><%= r.reviewer_name || '—' %></td>
                <td class="text-muted" style="font-size:12px;"><%= r.reviewed_at ? new Date(r.reviewed_at).toLocaleString() : '—' %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="rejectForm">
        <div class="modal-header">
          <h5 class="modal-title">Reject Request</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">Rejecting <strong id="rejectName"></strong>. You may add an optional note that will be emailed to them.</p>
          <textarea name="note" class="form-control" rows="3" placeholder="Optional note (e.g. reason / next steps)"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Reject Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Confirm before approving
document.querySelectorAll('.approve-form').forEach(function(f) {
  f.addEventListener('submit', function(e) {
    if (!confirm('Approve ' + f.dataset.name + '? A password will be generated and emailed to ' + f.dataset.email + '.')) {
      e.preventDefault();
    }
  });
});
// Open reject modal
document.querySelectorAll('.reject-btn').forEach(function(b) {
  b.addEventListener('click', function() {
    document.getElementById('rejectForm').action = '/doctor-requests/' + b.dataset.id + '/reject';
    document.getElementById('rejectName').textContent = b.dataset.name;
    new bootstrap.Modal(document.getElementById('rejectModal')).show();
  });
});
</script>
<%- include('../partials/scripts') %>
