      <div class="modal-header"><h5 class="modal-title">Update outcome</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <form method="POST" id="outcomeForm" enctype="multipart/form-data">
        <div class="modal-body row g-2">
          <div class="col-12">
            <label class="form-label">Outcome</label>
            <select name="outcome" id="outcomeSelect" class="form-select">
              <% ['Pending','Improved','No Change','Worsened','Cured','Referred'].forEach(o => { %>
              <option value="<%= o %>"><%= o %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Notes</label>
            <textarea name="outcome_notes" class="form-control" rows="2"></textarea>
          </div>
          <div class="col-12">
            <label class="form-label">Add a report</label>
            <input type="file" name="reports" class="form-control" accept="<%= ACCEPT %>" multiple/>
            <input type="text" name="report_label" class="form-control form-control-sm mt-2" placeholder="Label (optional)"/>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ══ Final status & discharge summary ══════════════════════════════════ -->
<div class="modal fade" id="dischargeModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title">Final status &amp; discharge</h5>
          <small class="text-muted" id="dischargeSubtitle"></small>
        </div>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" id="dischargeForm" enctype="multipart/form-data">
        <div class="modal-body row g-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Final status</label>
            <select name="final_status" id="finalStatus" class="form-select">
              <% ['Active','Discharged','Referred','Lost to Follow-up','Deceased'].forEach(f => { %>
              <option value="<%= f %>"><%= f %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Treatment status</label>
            <select name="status" id="dischargeStatus" class="form-select">
              <% ['Ongoing','Improved','Cured','Left Treatment'].forEach(st => { %>
              <option value="<%= st %>"><%= st %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Discharge date</label>
            <input type="date" name="discharge_date" id="dischargeDate" class="form-control"
                   value="<%= new Date().toISOString().split('T')[0] %>"/>
          </div>

          <div class="col-md-12">
            <label class="form-label">Improvement at discharge — <span id="impLabel">0</span>%</label>
            <input type="range" name="improvement_percentage" id="dischargeImp"
                   class="form-range" min="0" max="100" step="5" value="0"/>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Discharge summary</label>
            <textarea name="discharge_summary" id="dischargeSummary" class="form-control" rows="4"
                      placeholder="Course of treatment, response, condition at discharge, advice on diet and lifestyle, follow-up plan."></textarea>
          </div>
          <div class="col-12">
            <label class="form-label">Upload the signed discharge summary</label>
            <div class="upload-box">
              <input type="file" name="discharge_files" class="form-control" accept="<%= ACCEPT %>" multiple/>
              <small class="text-muted d-block mt-1">
                <i class="bi bi-paperclip me-1"></i>PDF, DOC/DOCX, JPEG or PNG · up to 2 files · 10 MB each
              </small>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2 me-1"></i>Save final status</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="addTreatmentModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">New Treatment</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <form id="addTreatmentForm">
        <input type="hidden" name="patient_id" value="<%=patient.patient_id%>"/>
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label">Disease *</label>
              <select name="disease_id" class="form-select" required>
                <option value="">Select Disease…</option>
                <% diseases.forEach(d => { %><option value="<%=d.disease_id%>"><%=d.disease_name%> (<%=d.category_name%>)</option><% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Doctor</label>
              <select name="doctor_id" class="form-select">
                <% doctors.forEach(d => { %><option value="<%=d.user_id%>" <%=d.user_id==user.userId?'selected':''%>><%=d.name%></option><% }) %>
              </select>
            </div>
            <div class="col-md-6"><label class="form-label">Start Date</label><input type="date" name="start_date" class="form-control" value="<%=new Date().toISOString().split('T')[0]%>"/></div>

            <!-- Medicines prescribed at start -->
            <div class="col-12">
              <label class="form-label mb-1">Medicines Prescribed *</label>
              <div id="medRows">
                <div class="row g-1 mb-1 med-row">
                  <div class="col-5"><select class="form-select form-select-sm med-name"><option value="">Select medicine…</option><% drugs.forEach(d => { %><option value="<%=d.name%>"><%=d.name%></option><% }) %></select></div>
                  <div class="col-3"><input class="form-control form-control-sm med-dosage" placeholder="Dosage (e.g. 500mg)"/></div>
                  <div class="col-3"><input class="form-control form-control-sm med-freq" placeholder="Frequency"/></div>
                  <div class="col-1 d-flex align-items-center"><button type="button" class="btn btn-sm btn-outline-danger med-remove" tabindex="-1">&times;</button></div>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-outline-secondary mt-1" id="addMedRow"><i class="bi bi-plus"></i> Add medicine</button>
            </div>

            <div class="col-md-6"><label class="form-label">Lifestyle Advice <small class="text-muted">(one per line)</small></label><textarea id="tLifestyle" class="form-control" rows="2" placeholder="e.g. Daily yoga&#10;Avoid heavy lifting"></textarea></div>
            <div class="col-md-6"><label class="form-label">Diet Advice <small class="text-muted">(one per line)</small></label><textarea id="tDiet" class="form-control" rows="2" placeholder="e.g. Warm water&#10;Avoid fried food"></textarea></div>
            <div class="col-12"><label class="form-label">Notes</label><textarea name="current_notes" class="form-control" rows="2"></textarea></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Create Treatment</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Add Follow-up Modal -->
