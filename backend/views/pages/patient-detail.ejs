<!-- Outcome Modal -->
<div class="modal fade" id="outcomeModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Record Drug Outcome</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <form id="outcomeForm">
        <input type="hidden" name="admin_id" id="outcomeAdminId"/>
        <div class="modal-body row g-2">
          <div class="col-12"><label class="form-label">Assessment Date</label><input type="date" name="assessment_date" class="form-control" value="<%=new Date().toISOString().split('T')[0]%>" required/></div>
          <div class="col-12"><label class="form-label">Efficacy Score (0–100)</label><input type="range" name="efficacy_score" class="form-range" min="0" max="100" step="5" value="70" oninput="document.getElementById('effVal').textContent=this.value+'%'"/><span id="effVal">70%</span></div>
          <div class="col-12"><label class="form-label">Side Effects</label><input type="text" name="side_effects" class="form-control" placeholder="None"/></div>
          <div class="col-12"><label class="form-label">Patient Feedback</label><input type="text" name="patient_feedback" class="form-control"/></div>
          <div class="col-12"><label class="form-label">Doctor Notes</label><textarea name="doctor_notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save Outcome</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
const PATIENT_ID = <%=patient.patient_id%>;

// Add another medicine row
document.getElementById('addMedRow').addEventListener('click', () => {
  const rows = document.getElementById('medRows');
  const clone = rows.querySelector('.med-row').cloneNode(true);
  clone.querySelectorAll('input').forEach(i => i.value = '');
  clone.querySelector('select').value = '';
  rows.appendChild(clone);
});
// Remove a medicine row (keep at least one)
document.getElementById('medRows').addEventListener('click', (e) => {
  if (e.target.closest('.med-remove')) {
    const rows = document.querySelectorAll('#medRows .med-row');
    if (rows.length > 1) e.target.closest('.med-row').remove();
  }
});
// Custom submit: build medicines/lifestyle/diet arrays then POST
document.getElementById('addTreatmentForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('[type=submit]');
  const orig = btn.innerHTML;
  const data = Object.fromEntries(new FormData(form));
  // medicines from the repeatable rows
  data.medicines_json = [...document.querySelectorAll('#medRows .med-row')].map(r => ({
    name: r.querySelector('.med-name').value.trim(),
    dosage: r.querySelector('.med-dosage').value.trim(),
    frequency: r.querySelector('.med-freq').value.trim(),
  })).filter(m => m.name);
  if (!data.medicines_json.length) { showToast('Add at least one medicine', 'error'); return; }
  const lines = (id) => document.getElementById(id).value.split('\n').map(s => s.trim()).filter(Boolean).map(s => ({ recommendation: s }));
  data.lifestyle_json = lines('tLifestyle');
  data.diet_json = lines('tDiet');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
  try {
    const r = await API.post('/api/treatments', data);
    showToast(r.message || 'Treatment created');
    closeModal('addTreatmentModal'); location.reload();
  } catch (err) { showToast(err.message || 'Error', 'error'); btn.disabled = false; btn.innerHTML = orig; }
});
ajaxForm('addFollowupForm','/api/followups','POST',()=>{ closeModal('addFollowupModal'); location.reload(); });
ajaxForm('addDrugAdminForm','/api/drugs/administrations','POST',()=>{ closeModal('addDrugModal'); location.reload(); });
ajaxForm('outcomeForm','/api/drugs/outcomes','POST',()=>{ closeModal('outcomeModal'); location.reload(); });

function openAddFollowup(tid, disease) {
  document.getElementById('followupTreatmentId').value = tid;
  document.getElementById('followupModalTitle').textContent = 'Add Follow-Up — ' + disease;
  openModal('addFollowupModal');
}
function openOutcomeModal(adminId) {
  document.getElementById('outcomeAdminId').value = adminId;
  openModal('outcomeModal');
}
function openEditTreatment(t) {
  alert('Edit treatment ID: ' + t.treatment_id + '\nUse API: PUT /api/treatments/' + t.treatment_id);
}
async function genPatientSummary() {
  const box = document.getElementById('aiResultBox');
  const content = document.getElementById('aiResultContent');
  box.classList.remove('d-none');
  content.innerHTML = '<div class="text-center py-3"><span class="spinner-border spinner-border-sm text-warning"></span> Generating AI summary…</div>';
  try {
    const r = await API.post('/api/ai/patient-summary/'+PATIENT_ID);
    content.innerHTML = '<div class="ai-report-body">' + (typeof marked!=='undefined'?marked.parse(r.report.report_text):r.report.report_text) + '</div>';
  } catch(e){ content.innerHTML='<div class="text-danger">'+e.message+'</div>'; }
}
async function genDropoutRisk() {
  const box = document.getElementById('aiResultBox');
  const content = document.getElementById('aiResultContent');
  box.classList.remove('d-none');
  content.innerHTML = '<div class="text-center py-3"><span class="spinner-border spinner-border-sm text-warning"></span> Analysing dropout risk…</div>';
  try {
    const r = await API.post('/api/ai/dropout-risk/'+PATIENT_ID);
    const riskColor = r.risk==='High'?'danger':r.risk==='Medium'?'warning':'success';
    content.innerHTML = `<div class="alert alert-${riskColor} mb-2"><strong>Dropout Risk: ${r.risk}</strong></div><div class="ai-report-body">${typeof marked!=='undefined'?marked.parse(r.report.report_text):r.report.report_text}</div>`;
  } catch(e){ content.innerHTML='<div class="text-danger">'+e.message+'</div>'; }
}

// ══ Consultations: drug rows, outcome + discharge modals ══════════════════
(function () {
  // Repeating "drugs advised" rows on the consultation form.
  const rows = document.getElementById('consultDrugRows');
  document.getElementById('addConsultDrug')?.addEventListener('click', () => {
    const first = rows.querySelector('.consult-drug-row');
    const clone = first.cloneNode(true);
    clone.querySelectorAll('select, input').forEach(el => { el.value = ''; });
    rows.appendChild(clone);
  });
  rows?.addEventListener('click', (e) => {
    if (!e.target.closest('.rm-drug')) return;
    const all = rows.querySelectorAll('.consult-drug-row');
    if (all.length > 1) e.target.closest('.consult-drug-row').remove();
    else all[0].querySelectorAll('select, input').forEach(el => { el.value = ''; });
  });

  // Guard against a submit that would be rejected server-side anyway.
  const ACCEPT = ['pdf','doc','docx','jpg','jpeg','png'];
  const MAX = 10 * 1024 * 1024;
  document.addEventListener('change', (e) => {
    if (e.target.type !== 'file') return;
    for (const f of e.target.files) {
      const ext = f.name.split('.').pop().toLowerCase();
      if (!ACCEPT.includes(ext)) {
        alert(`“${f.name}” is not an accepted format. Use PDF, DOC/DOCX, JPEG or PNG.`);
        e.target.value = ''; return;
      }
      if (f.size > MAX) {
        alert(`“${f.name}” is larger than 10 MB.`);
        e.target.value = ''; return;
      }
    }
  });
})();

function openOutcome(consultationId, current) {
  const form = document.getElementById('outcomeForm');
  form.action = '/consultations/' + consultationId + '/outcome';
  form.reset();
  document.getElementById('outcomeSelect').value = current || 'Pending';
  new bootstrap.Modal(document.getElementById('outcomeModal')).show();
}

function openDischarge(t) {
  const form = document.getElementById('dischargeForm');
  form.action = '/treatments/' + t.treatment_id + '/discharge';
  form.reset();
  document.getElementById('dischargeSubtitle').textContent = t.disease_name || '';
  document.getElementById('finalStatus').value =
    ['Active','Discharged','Referred','Lost to Follow-up','Deceased'].includes(t.final_status)
      ? t.final_status : 'Discharged';
  document.getElementById('dischargeStatus').value = t.status || 'Ongoing';
  if (t.discharge_date) document.getElementById('dischargeDate').value = String(t.discharge_date).slice(0, 10);
  document.getElementById('dischargeSummary').value = t.discharge_summary || '';
  const imp = document.getElementById('dischargeImp');
  imp.value = t.improvement_percentage || 0;
  document.getElementById('impLabel').textContent = imp.value;
  new bootstrap.Modal(document.getElementById('dischargeModal')).show();
}

document.getElementById('dischargeImp')?.addEventListener('input', (e) => {
  document.getElementById('impLabel').textContent = e.target.value;
});

// Land on the consultations tab when redirected back with #consultations
if (location.hash === '#consultations') {
  document.querySelector('[href="#consultTab"]')?.click();
}
</script>
<%- include('../partials/scripts') %>
