<%- include('../partials/head', { title: 'Patients' }) %>
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'patients' }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { title: 'Patient Management' }) %>
    <div class="page-body">

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h5 class="mb-0 text-green">Patient Management</h5>
          <small class="text-muted"><%= total %> patients found</small>
        </div>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPatientModal">
          <i class="bi bi-person-plus me-1"></i>Add Patient
        </button>
      </div>

      <!-- Filters -->
      <div class="card mb-3">
        <div class="card-body py-2">
          <form method="GET" action="/patients" class="row g-2 align-items-end">
            <div class="col-12 col-sm-4">
              <input type="text" name="search" class="form-control form-control-sm"
                placeholder="Search name, code, phone…" value="<%= filters.search||'' %>"/>
            </div>
            <div class="col-6 col-sm-3">
              <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <% ['Ongoing','Improved','Cured','Left Treatment'].forEach(s => { %>
                <option value="<%=s%>" <%=filters.status===s?'selected':''%>><%=s%></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 col-sm-3">
              <select name="my_patients" class="form-select form-select-sm">
                <option value="">All Patients</option>
                <option value="true" <%=filters.my_patients==='true'?'selected':''%>>My Patients</option>
              </select>
            </div>
            <div class="col-12 col-sm-2 d-flex gap-1">
              <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
              <a href="/patients" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
          </form>
        </div>
      </div>

      <!-- Table -->
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Patient</th><th>Code</th><th>Age/Gender</th>
                <th>Disease</th><th>Doctor</th><th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (patients.length === 0) { %>
              <tr><td colspan="7" class="text-center py-5 text-muted">No patients found</td></tr>
              <% } %>
              <% patients.forEach(p => { %>
              <tr class="cursor-pointer" onclick="window.location='/patients/<%=p.patient_id%>'">
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="pat-avatar"><%=p.name.charAt(0)%></div>
                    <span class="fw-medium" style="font-size:13px;"><%=p.name%></span>
                  </div>
                </td>
                <td><span class="patient-code"><%=p.patient_code%></span></td>
                <td><small><%=p.age%>y / <%=p.gender.charAt(0)%></small></td>
                <td><small><%=p.disease_name||'—'%></small></td>
                <td><small><%=p.doctor_name||'—'%></small></td>
                <td>
                  <% const sc={Ongoing:'badge-ongoing',Improved:'badge-improved',Cured:'badge-cured','Left Treatment':'badge-left'}; %>
                  <% if (p.treatment_status) { %>
                  <span class="status-badge <%=sc[p.treatment_status]||''%>"><%=p.treatment_status%></span>
                  <% } else { %>
                  <span class="text-muted small">No Treatment</span>
                  <% } %>
                </td>
                <td onclick="event.stopPropagation()">
                  <a href="/patients/<%=p.patient_id%>" class="btn btn-sm btn-outline-primary me-1" title="View"><i class="bi bi-eye"></i></a>
                  <button class="btn btn-sm btn-outline-danger" title="Remove"
                    onclick="deleteRecord('/api/patients/<%=p.patient_id%>',()=>location.reload())">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
        <div class="card-footer d-flex justify-content-between align-items-center">
          <small class="text-muted">Page <%=currentPage%> of <%=totalPages%></small>
          <nav><ul class="pagination pagination-sm mb-0">
            <% if (currentPage > 1) { %><li class="page-item"><a class="page-link" href="?page=<%=currentPage-1%>&search=<%=filters.search||''%>&status=<%=filters.status||''%>">Prev</a></li><% } %>
            <% if (currentPage < totalPages) { %><li class="page-item"><a class="page-link" href="?page=<%=currentPage+1%>&search=<%=filters.search||''%>&status=<%=filters.status||''%>">Next</a></li><% } %>
          </ul></nav>
        </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<!-- Add Patient Modal -->
<div class="modal fade" id="addPatientModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Patient</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addPatientForm">
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-8"><label class="form-label">Full Name *</label><input type="text" name="name" class="form-control" required/></div>
            <div class="col-4"><label class="form-label">Age *</label><input type="number" name="age" class="form-control" required min="1" max="120"/></div>
            <div class="col-6">
              <label class="form-label">Gender *</label>
              <select name="gender" class="form-select" required>
                <option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option>
              </select>
            </div>
            <div class="col-6"><label class="form-label">Phone</label><input type="tel" name="phone" class="form-control"/></div>
            <div class="col-12"><label class="form-label">Occupation</label><input type="text" name="occupation" class="form-control"/></div>
            <div class="col-12"><label class="form-label">Address</label><textarea name="address" class="form-control" rows="2"></textarea></div>

            <div class="col-12"><hr class="my-1"/><small class="text-muted">Optionally start a treatment now (you can also add it later from the patient page).</small></div>
            <div class="col-7">
              <label class="form-label">Disease</label>
              <select name="disease_id" id="patDisease" class="form-select">
                <option value="">— none yet —</option>
                <% let lastCat=null; (typeof diseases!=='undefined'?diseases:[]).forEach(d=>{ if(d.category_name!==lastCat){ lastCat=d.category_name; %><optgroup label="<%=d.category_name%>"><% } %><option value="<%=d.disease_id%>"><%=d.disease_name%></option><% }) %>
              </select>
            </div>
            <div class="col-5">
              <label class="form-label">Doctor</label>
              <select name="doctor_id" id="patDoctor" class="form-select">
                <% (typeof doctors!=='undefined'?doctors:[]).forEach(d=>{ %><option value="<%=d.user_id%>" <%=d.user_id==user.userId?'selected':''%>><%=d.name%></option><% }) %>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Add Patient</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('addPatientForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('[type=submit]');
  const orig = btn.innerHTML;
  const data = Object.fromEntries(new FormData(form));
  const diseaseId = data.disease_id;
  const doctorId = data.doctor_id;
  delete data.disease_id; delete data.doctor_id; // not columns on Patients
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
  try {
    const r = await API.post('/api/patients', data);
    // If a disease was chosen, start an initial treatment so the patient is linked to it
    if (diseaseId) {
      await API.post('/api/treatments', {
        patient_id: r.patientId, disease_id: diseaseId, doctor_id: doctorId,
        start_date: new Date().toISOString().split('T')[0],
        medicines_json: [], lifestyle_json: [], diet_json: [], current_notes: ''
      });
    }
    showToast('Patient added' + (diseaseId ? ' with treatment' : ''));
    closeModal('addPatientModal'); location.reload();
  } catch (err) { showToast(err.message || 'Error', 'error'); btn.disabled = false; btn.innerHTML = orig; }
});
</script>
<%- include('../partials/scripts') %>
