<%- include('../partials/head', { title: 'Sign In' }) %>
<link rel="stylesheet" href="/css/main.css"/>

<div class="login-page position-relative overflow-hidden">
  <!-- Decorative rings -->
  <% [320,520,720,920].forEach((s,i) => { %>
  <div class="ring" style="width:<%=s%>px;height:<%=s%>px;border:1px solid rgba(201,168,76,<%=(0.09-i*0.018).toFixed(3)%>);top:50%;right:<%=-s/3.5%>px;transform:translateY(-50%);"></div>
  <% }) %>

  <div class="login-shell">

  <!-- Left Branding -->
  <div class="login-branding">
    <div class="d-flex align-items-center gap-3 mb-5">
      <div style="padding:12px;background:rgba(201,168,76,0.15);border-radius:12px;">
        <i class="bi bi-flower2" style="font-size: 44px;color:#c9a84c;"></i>
      </div>
      <div>
        <div style="color:#fff;font-family:'Playfair Display',serif;font-weight:800;font-size: 46px;line-height:1;">AYUSHI</div>
        <div style="color:rgba(201,168,76,0.85);font-size: 12px;letter-spacing:3.5px;margin-top:4px;">AYURVEDIC CLINICAL SYSTEM</div>
      </div>
    </div>
    <p style="color:#fff;font-family:'Playfair Display',serif;font-size: 27px;font-weight:600;line-height:1.45;max-width:400px;margin-bottom:14px;">
      Bridging Ayurvedic Wisdom with Clinical Intelligence
    </p>
    <p style="color:rgba(255,255,255,0.6);font-size: 16px;line-height:1.9;max-width:380px;margin-bottom:40px;">
      Manage patients, track treatments, research drug efficacy and generate AI-powered clinical insights — all in one platform.
    </p>
    <% [
      ['🌿','500+ patients, 75 diseases, 25 doctors'],
      ['💊','Drug efficacy research & AI analytics'],
      ['📊','Real-time analytics & disease intelligence'],
      ['🤖','Google Gemini AI clinical insights'],
      ['📋','Automatic patient timeline tracking'],
    ].forEach(([icon,text]) => { %>
    <div class="d-flex align-items-center gap-3 mb-2">
      <div style="width:30px;height:30px;border-radius:8px;background:rgba(201,168,76,0.12);display:flex;align-items:center;justify-content:center;font-size: 17px;flex-shrink:0;"><%=icon%></div>
      <span style="color:rgba(255,255,255,0.75);font-size: 16px;"><%=text%></span>
    </div>
    <% }) %>
  </div>

  <!-- Right Card -->
  <div class="login-card-wrap">
    <div class="card login-card w-100" style="max-width:440px;">
      <div class="card-body p-4 p-sm-5">
        <!-- Mobile logo -->
        <div class="d-lg-none d-flex align-items-center justify-content-center gap-2 mb-4">
          <i class="bi bi-flower2" style="font-size: 29px;color:#4a7c59;"></i>
          <span style="font-family:'Playfair Display',serif;color:#2d5c3e;font-weight:700;font-size: 25px;">AYUSHI</span>
        </div>

        <!-- Flash messages -->
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
          <%- error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
          <%- success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <!-- Tabs -->
        <ul class="nav login-tabs border-bottom mb-4" id="authTab">
          <li class="nav-item me-3">
            <a class="nav-link <%= activeTab==='signup' ? '' : 'active' %>" id="signin-tab"
               data-bs-toggle="tab" href="#signinPane">
              <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= activeTab==='signup' ? 'active' : '' %>" id="signup-tab"
               data-bs-toggle="tab" href="#signupPane">
              <i class="bi bi-person-plus me-1"></i>Sign Up
            </a>
          </li>
        </ul>

        <div class="tab-content">

          <!-- ── SIGN IN ── -->
          <div class="tab-pane fade <%= activeTab==='signup' ? '' : 'show active' %>" id="signinPane">
            <h6 class="fw-bold text-green mb-1">Welcome back</h6>
            <p class="text-muted small mb-3">Sign in to your AYUSHI dashboard</p>

            <form method="POST" action="/login" id="loginForm">
              <div class="mb-3">
                <label class="form-label">Email Address</label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="bi bi-envelope text-green"></i></span>
                  <input type="email" name="email" class="form-control" required
                    placeholder="your@email.com"
                    value="<%= typeof prefillEmail !== 'undefined' ? prefillEmail : '' %>"/>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="bi bi-lock text-green"></i></span>
                  <input type="password" name="password" id="loginPw" class="form-control" required placeholder="••••••••"/>
                  <button class="btn btn-outline-secondary" type="button" onclick="togglePw('loginPw',this)">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>
              <button type="submit" class="btn btn-primary w-100 py-2 mt-1" id="loginBtn">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
              </button>
            </form>

            <div class="mt-3 p-3 rounded-3" style="background:#f0f7f3;border:1px solid #c8e6c9;">
              <div class="small text-muted">Doctors join via <strong>Sign Up</strong> → admin approval.</div>
            </div>
          </div>

          <!-- ── SIGN UP ── -->
          <div class="tab-pane fade <%= activeTab==='signup' ? 'show active' : '' %>" id="signupPane">
            <!-- Request to Join (admin approval flow) -->
            <h6 class="fw-bold text-green mb-1">Request to Join</h6>
            <p class="text-muted small mb-3">Submit your details — an administrator will review your request and email your login credentials once approved.</p>
            <form method="POST" action="/request-join">
              <div class="row g-2 mb-2">
                <div class="col-12">
                  <label class="form-label">Full Name *</label>
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person text-green"></i></span>
                    <input type="text" name="name" class="form-control" required placeholder="Dr. Your Name"/>
                  </div>
                </div>
                <div class="col-12">
                  <label class="form-label">Email Address *</label>
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-envelope text-green"></i></span>
                    <input type="email" name="email" class="form-control" required placeholder="your@email.com"/>
                  </div>
                </div>
                <div class="col-6">
                  <label class="form-label">Phone</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-phone text-green"></i></span>
                    <input type="tel" name="phone" class="form-control" placeholder="9876543210"/>
                  </div>
                </div>
                <div class="col-6">
                  <label class="form-label">Specialization</label>
                  <input type="text" name="specialization" class="form-control form-control-sm" placeholder="Digestive, Skin…"/>
                </div>
                <div class="col-12">
                  <label class="form-label">About You / Why You Want to Join *</label>
                  <textarea name="description" class="form-control" rows="3" required
                    placeholder="Briefly describe your background, qualifications, and why you'd like to join the AYUSHI clinic."></textarea>
                </div>
              </div>
              <button type="submit" class="btn btn-primary w-100 py-2 mt-1">
                <i class="bi bi-send me-1"></i>Submit Join Request
              </button>
              <p class="text-muted text-center mt-2 mb-0" style="font-size: 13px;">
                You'll receive your password by email after the admin approves your request.
              </p>
            </form>
          </div>

        </div><!-- tab-content -->

        <hr class="mt-4 mb-3"/>
        <p class="text-center text-muted mb-0" style="font-size: 13px;">
          AYUSHI · BMSCE Final Year Project · CSE 2023–27
        </p>
      </div>
    </div>
  </div>

  </div><!-- /.login-shell -->
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
function togglePw(id, btn) {
  const inp = document.getElementById(id);
  if (!inp) return;
  const isText = inp.type === 'text';
  inp.type = isText ? 'password' : 'text';
  btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
}
// Loading state on login submit
document.getElementById('loginForm')?.addEventListener('submit', function() {
  const btn = document.getElementById('loginBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Signing in…'; }
});
// Validate passwords match
document.querySelector('form[action="/register"]')?.addEventListener('submit', function(e) {
  const p1 = document.getElementById('regPw')?.value;
  const p2 = document.getElementById('regPw2')?.value;
  if (p1 !== p2) { e.preventDefault(); alert('Passwords do not match.'); }
});
</script>
</body>
</html>
