<%- include('../partials/head', { title: 'Reports' }) %>
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'reports' }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { title: 'Reports' }) %>
    <div class="page-body">
      <div class="mb-3"><h5 class="text-green mb-0">Reports</h5><small class="text-muted">Generate and download PDF reports</small></div>
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card" style="border:1px solid #4a7c5940;">
            <div class="card-body">
              <div class="d-flex gap-3 mb-3">
                <div style="padding:12px;background:#e8f5e9;border-radius:10px;font-size:28px;color:#4a7c59;"><i class="bi bi-person"></i></div>
                <div><div class="fw-semibold">Patient Report</div><small class="text-muted">Patient details, treatments, follow-ups and timeline as PDF.</small></div>
              </div>
              <div class="mb-2"><label class="form-label">Patient ID</label><input type="number" id="patientIdInput" class="form-control" placeholder="Enter numeric patient ID (e.g. 1, 25)"/></div>
              <a id="patientReportBtn" href="#" class="btn btn-primary btn-sm w-100" onclick="downloadPatientReport()">
                <i class="bi bi-download me-1"></i>Download Patient Report
              </a>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card" style="border:1px solid #2980b940;">
            <div class="card-body">
              <div class="d-flex gap-3 mb-3">
                <div style="padding:12px;background:#e3f2fd;border-radius:10px;font-size:28px;color:#2980b9;"><i class="bi bi-building"></i></div>
                <div><div class="fw-semibold">Clinic Summary Report</div><small class="text-muted">Overall clinic statistics and performance overview as PDF.</small></div>
              </div>
              <a href="/api/reports/clinic" target="_blank" class="btn btn-sm w-100" style="background:#2980b9;color:#fff;">
                <i class="bi bi-download me-1"></i>Download Clinic Report
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="card mt-3" style="background:#fdfbf7;border:1px solid #e8d9c0;">
        <div class="card-body">
          <div class="fw-semibold text-warning mb-2"><i class="bi bi-info-circle me-1"></i>Report Notes</div>
          <ul class="mb-0" style="font-size:13px;">
            <li><strong>Patient Report:</strong> Includes demographics, treatment history, follow-up records and timeline.</li>
            <li><strong>Clinic Report:</strong> Aggregated stats including patient counts, cure rates and doctor overview.</li>
            <li>All reports are generated as PDF and include an AYUSHI watermark.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function downloadPatientReport() {
  const id = document.getElementById('patientIdInput').value;
  if (!id) { showToast('Please enter a Patient ID','error'); return; }
  window.open('/api/reports/patient/'+id,'_blank');
}
</script>
<%- include('../partials/scripts') %>