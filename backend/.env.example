# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ayushi_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=ayushi_jwt_secret_2024_change_me
JWT_EXPIRES_IN=7d

# ─── Email (Gmail) ─────────────────────────────────────────────────────────────
# Create a Gmail App Password at: https://myaccount.google.com/apppasswords
# (Enable 2FA first, then generate an App Password for "Mail")
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ayushiayurveda.repo@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=AYUSHI Clinic <ayushiayurveda.repo@gmail.com>

# ─── AI (Gemini) ───────────────────────────────────────────────────────────────
# Free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use. Free tier is limited per-model per-day; gemini-2.5-flash has more
# headroom than gemini-flash-latest (→3.5-flash, ~20/day). Reports are cached so
# normal viewing doesn't consume quota — only first generation + "Regenerate".
GEMINI_MODEL=gemini-2.5-flash

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
