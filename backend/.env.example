# ─── Database ──────────────────────────────────────────────────────────────────
# Two ways to configure. DATABASE_URL wins if it is set.

# 1. Hosted: paste the connection string your provider gives you.
#    Railway / Aiven / Clever Cloud / PlanetScale / RDS all hand you one of these.
# DATABASE_URL=mysql://user:password@host.provider.com:3306/ayushi_db

# 2. Discrete variables (used when DATABASE_URL is absent).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ayushi_db

# TLS — required by essentially every hosted provider.
# DB_SSL=true                      # verify against the system trust store
# DB_SSL_CA=certs/provider-ca.pem  # or point at a CA bundle the provider supplies
# DB_SSL_INSECURE=false            # leave false; true disables certificate checks

# Tuning (optional). Hosted free tiers cap connections — keep the pool small.
# DB_POOL_SIZE=8
# DB_CONNECT_TIMEOUT=20000

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Email (Gmail app password, not your normal password) ──────────────────────
# Create one at https://myaccount.google.com/apppasswords (enable 2FA first)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=AYUSHI Clinic <your@email.com>

# ─── AI (Gemini) ───────────────────────────────────────────────────────────────
# Free API key at https://aistudio.google.com/
GEMINI_API_KEY=

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
